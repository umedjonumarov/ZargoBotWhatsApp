# ZargoBot — Atrof-muhit o'zgaruvchilari
# Render dashboard'ga shu nomlar bilan qo'shish kerak
# (Bu fayl misol uchun, .env faylga ko'chirib, qiymatlarni to'ldiring)

# OpenAI API key (https://platform.openai.com)
OPENAI_API_KEY=sk-your-openai-key-here

# Green API (https://green-api.com)
GREEN_API_INSTANCE_ID=7107601809
GREEN_API_TOKEN=your-green-api-token-here

# Google Sheets Apps Script URL (allaqachon kodda bor, lekin o'zgartirish uchun)
SHEETS_URL=https://script.google.com/macros/s/AKfycbx.../exec

# Cron task'lar uchun maxfiy kalit (oddiy parol)
CRON_SECRET=zargo-bot-cron-2026
